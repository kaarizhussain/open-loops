# Font binaries are a build cache — build.js re-downloads them on demand.
# The built index.html embeds them, and fonts/OFL-*.txt carries their licenses.
fonts/*.woff2

node_modules/
.DS_Store
openloops.config.json
ledger.json

# The Enron corpus is 443MB of somebody else's mail. tools/enron.js says where to
# get it; it must never be committed here.
maildir/
enron_mail_*.tar.gz
